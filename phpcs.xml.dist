<?xml version="1.0"?>
<ruleset name="Notify with GOWA Coding Standards">
    <description>WordPress Coding Standards for Notify with GOWA plugin.</description>

    <!-- Scan all PHP files in the project -->
    <file>.</file>

    <!-- Exclude non-plugin directories and non-distributed legacy files -->
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>
    <exclude-pattern>/.wordpress-org/*</exclude-pattern>
    <exclude-pattern>/assets/*</exclude-pattern>
    <exclude-pattern>/includes/class-gowa-updater.php</exclude-pattern>

    <!-- Only scan PHP files -->
    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <arg value="ps"/>

    <!-- Set minimum PHP version requirement (PHP 7.4 to 8.3) -->
    <config name="testVersion" value="7.4-8.3"/>
    <rule ref="PHPCompatibilityWP"/>

    <!-- WordPress Security Standards -->
    <rule ref="WordPress.Security"/>

    <!-- WordPress Internationalization -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="notify-with-gowa"/>
            </property>
        </properties>
    </rule>

    <!-- WordPress Prefix Conventions -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="gowa"/>
                <element value="notify_with_gowa"/>
                <element value="GOWA"/>
            </property>
        </properties>
    </rule>
</ruleset>